# Confirm current value in https://docs.arc.io/arc/references/rpc-endpoints
ARC_RPC_URL=https://rpc.testnet.arc.network

# Set after running the Foundry deploy script from the contracts project
PAYMENT_RECEIVER_ADDRESS=

# How many blocks past a log to wait before treating it as final.
# Confirm Arc's current finality/block-time figures in docs.arc.io before tuning this.
CONFIRMATIONS=1

POLL_INTERVAL_MS=3000

# Deployment block of PaymentReceiver — avoids scanning from genesis on first run.
START_BLOCK=0

# The backend API (arc-backend) this indexer reports settled payments to.
BACKEND_URL=http://localhost:4000
# Must match arc-backend's INDEXER_API_KEY.
INDEXER_API_KEY=change-me-indexer
