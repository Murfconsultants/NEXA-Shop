PORT=4000

# Used to protect POST/PATCH/DELETE product routes and all /api/admin routes.
# The admin dashboard sends this from its server side only — never expose it to a browser.
ADMIN_API_KEY=change-me-admin

# Used to protect /api/orders/:id/mark-paid — give this one to the indexer only.
INDEXER_API_KEY=change-me-indexer

# Signs SIWE session cookies. Generate with `openssl rand -hex 32`.
SESSION_SECRET=change-me-session-secret

# Storefront origin — required for credentialed CORS (SIWE cookies).
FRONTEND_ORIGIN=http://localhost:3000

# Optional — order confirmation emails are skipped (with a log line) if unset.
RESEND_API_KEY=
EMAIL_FROM=orders@example.com

# Minutes a "pending" order can sit unpaid before it's auto-cancelled and its
# reserved inventory is restocked. See the expiry sweep in src/server.ts
# (local dev, checks every 60s) — on Vercel Hobby, the cron in vercel.json
# only runs once/day (Hobby plan limit), so in practice inventory gets
# released at most once daily there, not within this window. Use the admin
# dashboard's manual "Cancel & restock" button for anything more urgent, or
# upgrade to Vercel Pro for a tighter cron schedule.
ORDER_EXPIRY_MINUTES=15

# Optional — when set, the backend uses PostgresStore instead of the local
# store.json file (see src/store.ts). Run migrations first: npm run migrate
DATABASE_URL=

# Optional — enables direct-to-Cloudinary image uploads from the admin
# dashboard (POST /api/admin/uploads/signature). Product images work fine
# without this too, via the plain imageUrl field.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required in production / on Vercel — without these, SIWE sessions and
# nonces use an in-memory Map that doesn't survive across serverless
# invocations (see src/session.ts). Get a free Upstash Redis database at
# https://console.upstash.com and paste its REST URL/token here. Safe to
# leave blank for local dev (falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects POST/GET /api/cron/expire-orders from being triggered by anyone
# who finds the URL. Vercel Cron sends this automatically once set as an
# env var — see vercel.json. Generate with `openssl rand -hex 32`.
CRON_SECRET=
