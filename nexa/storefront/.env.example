# WalletConnect Cloud project ID — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Confirm current values in https://docs.arc.io/arc/references/rpc-endpoints
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_WS_URL=wss://rpc.testnet.arc.network

# Arc's native USDC ERC-20 interface — confirm in https://docs.arc.io/arc/references/contract-addresses
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Set after running the Foundry deploy script from the contracts project
NEXT_PUBLIC_PAYMENT_RECEIVER_ADDRESS=

# The backend API (arc-backend). Public because the storefront calls it
# directly from the browser (products, cart checkout, SIWE) with credentials: include.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
